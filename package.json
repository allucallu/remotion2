{
  "name": "flexible-remotion-asset-studio",
  "version": "2.0.0",
  "description": "A flexible Remotion workspace for reusable motion-graphics assets",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.465",
    "@remotion/google-fonts": "4.0.465",
    "@remotion/media-utils": "4.0.465",
    "@remotion/noise": "4.0.465",
    "@remotion/paths": "4.0.465",
    "@remotion/shapes": "4.0.465",
    "@remotion/tailwind-v4": "4.0.465",
    "@remotion/zod-types": "4.0.465",
    "lucide-react": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.465",
    "tailwindcss": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.465",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render MV out/mv.mp4 --codec=h264",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc",
    "metadata:generate": "node scripts/stock-metadata.mjs generate",
    "metadata:check": "node scripts/stock-metadata.mjs check",
    "metadata:manifest": "node scripts/stock-metadata.mjs manifest",
    "metadata:verify-rendered": "node scripts/stock-metadata.mjs verify-rendered",
    "lint": "eslint src && tsc",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \".github/workflows/*.yml\" README.md remotion.config.ts eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \".github/workflows/*.yml\" README.md remotion.config.ts eslint.config.mjs tsconfig.json package.json"
  },
  "sideEffects": [
    "*.css"
  ]
}
